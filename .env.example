# Copy to .env for local use against the cloud database.
# Leave both blank to use a local SQLite file in data/ instead.

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Password given to the "admin" account the very first time the database is
# created. Ignored afterwards. Change it in the app once you sign in.
ADMIN_PASSWORD=
